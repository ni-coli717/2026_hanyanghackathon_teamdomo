+/* ---------------- USB 시연 명령 ---------------- */
+// 시연 웹(demo/)이 가동 구간에 들어가면 "FAN ON", 나오면 "FAN OFF" 를 보낸다. 대소문자·CR 무시, 32자 넘는 줄은 버림.
+void readSerial() {
+  while (Serial.available()) {
+    char c = Serial.read();
+    if (c == '\r') continue;
+    if (c != '\n') { if (serialBuf.length() < 32) serialBuf += c; continue; }
+    String line = serialBuf; serialBuf = ""; line.trim(); line.toUpperCase();
+    bool on;
+    if (line == "FAN ON") on = true;
+    else if (line == "FAN OFF") on = false;
+    else { if (line.length()) Serial.printf("? %s\n", line.c_str()); continue; }
+    usbDemo = true; manualMode = false; linkAlive = true; level = "DEMO"; basis = "USB"; wind = "NA";
+    bool before = fanOn; fanOn = on;
+    Serial.printf("OK FAN %s\n", on ? "ON" : "OFF");
+    if (before != fanOn) applyState(); else drawPage();
+  }
+}
